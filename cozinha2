    def draw_overlay_ui(self):
        # top instructions
        info_text = "Clique nos objetos da cozinha para avançar na fase. ESC volta ao cenário."
        txt = self.font.render(info_text, True, BLACK)
        self.screen.blit(txt, (20, 12))

