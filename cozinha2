@dataclass
class MessageBox:
    text: str = ""
    timer: int = 0
    duration: int = 240

    def show(self, text: str, duration: int = 240):
        self.text = text
        self.timer = duration
        self.duration = duration

    def update(self):
        if self.timer > 0:
            self.timer -= 1

    @property
    def visible(self):
        return self.timer > 0 and bool(self.text)


class Button:
    def __init__(self, rect, label, color=(70, 70, 70), text_color=WHITE):
        self.rect = pygame.Rect(rect)
        self.label = label
        self.color = color
        self.text_color = text_color

    def draw(self, screen, font):
        pygame.draw.rect(screen, self.color, self.rect, border_radius=10)
        pygame.draw.rect(screen, WHITE, self.rect, 2, border_radius=10)
        txt = font.render(self.label, True, self.text_color)
        screen.blit(txt, txt.get_rect(center=self.rect.center))

    def hit(self, pos):
        return self.rect.collidepoint(pos)


class MemoryCard:
    def __init__(self, rect, creature):
        self.rect = pygame.Rect(rect)
        self.creature = creature
        self.revealed = False
        self.matched = False


class DraggablePiece:
    def __init__(self, name, pos, target_center, color, target_size=(50, 50)):
        self.name = name
        self.pos = list(pos)
        self.start_pos = list(pos)
        self.target_rect = pygame.Rect(0, 0, target_size[0], target_size[1])
        self.target_rect.center = target_center
        self.color = color
        self.dragging = False
        self.snapped = False
        self.offset = (0, 0)
        self.radius = 24

    def rect(self):
        return pygame.Rect(self.pos[0] - self.radius, self.pos[1] - self.radius, self.radius * 2, self.radius * 2)


class LabelTag:
    def __init__(self, text, pos, color):
        self.text = text
        self.pos = list(pos)
        self.start_pos = list(pos)
        self.color = color
        self.dragging = False
        self.offset = (0, 0)
        self.rect = pygame.Rect(0, 0, 120, 34)
        self.rect.center = pos
        self.locked = False

    def update_rect(self, font):
        self.rect.size = (font.size(self.text)[0] + 20, 34)
        self.rect.center = self.pos


class WireEndpoint:
    def __init__(self, name, pos, color):
        self.name = name
        self.pos = pos
        self.color = color
        self.radius = 18
        self.connected = False

    def hit(self, mouse):
        return math.dist(self.pos, mouse) <= self.radius + 5


class Game:
    def __init__(self):
        pygame.init()
        pygame.display.set_caption("Cozinha Assombrada - Fase de Puzzles")
        self.screen = pygame.display.set_mode((WIDTH, HEIGHT))
        self.clock = pygame.time.Clock()
        self.font = pygame.font.SysFont("arial", 24)
        self.font_big = pygame.font.SysFont("arial", 40, bold=True)
        self.font_huge = pygame.font.SysFont("arial", 58, bold=True)

        # coloque a imagem da cozinha na mesma pasta do jogo
        # e renomeie para: cozinha.png
        self.background_image = pygame.image.load("cozinha.png").convert()
        self.background_image = pygame.transform.scale(self.background_image, (WIDTH, HEIGHT))

        self.state = "scene"
        self.message = MessageBox()
        self.selected_item = None
        self.show_book_page = False
        self.has_key = False
        self.game_over = False

        self.oven_state = {"done": False}
        self.faucet_state = {"leaks_fixed": 0, "done": False}
        self.spoon_clicked = False
        self.cabinet_clicked = False
        self.rug_state = {"cleaned": 0, "done": False}
        self.spice_state = {"done": False}
        self.light_state = {"done": False}
        self.plates_state = {"done": False}

        self._build_scene()
        self._build_memory_game()
        self._build_plate_game()
        self._build_spice_game()
        self._build_wire_game()

        self.dragging_piece = None
        self.dragging_label = None
        self.pending_wire = None
        self.wire_connections = []

    def _build_scene(self):
        self.hotspots = {
            # queimador/forno no canto inferior esquerdo
            "oven": pygame.Rect(20, 500, 240, 190),
            # pia/torneira na bancada central-direita
            "faucet": pygame.Rect(680, 370, 230, 170),
            # livro de receitas sobre a bancada central-esquerda
            "book": pygame.Rect(360, 375, 170, 130),
            # colher de pau no porta-utensílios
            "spoon": pygame.Rect(550, 360, 115, 150),
            # armário/prateleira da direita
            "cabinet": pygame.Rect(1030, 360, 190, 190),
            # pilha de pratos na prateleira superior direita
            "plates": pygame.Rect(860, 95, 250, 170),
            # tapete no chão ao centro
            "rug": pygame.Rect(360, 615, 390, 110),
            # temperos/porta-temperos na direita
            "spices": pygame.Rect(1030, 360, 150, 220),
            # lâmpada no topo central
            "light": pygame.Rect(760, 0, 110, 140),
        }

        self.stove_flame = True
        # gotinhas do vazamento perto da pia da imagem
        self.leaks = [pygame.Rect(835 + i * 18, 462 + (i % 2) * 14, 12, 12) for i in range(3)]
        # poeira no tapete central
        self.rug_dust_spots = [pygame.Rect(385 + i * 42, 640 + (i % 2) * 12, 22, 22) for i in range(9)]
        self.light_fix_button = Button((990, 120, 220, 42), "Consertar fios", color=(60, 60, 60))

    def _build_memory_game(self):
        creatures = ["Vampiro", "Fantasma", "Múmia", "Lobisomem"]
        deck = creatures * 2
        random.shuffle(deck)
        self.memory_cards = []
        start_x = 110
        start_y = 150
        gap_x = 120
        gap_y = 110
        card_w = 100
        card_h = 90
        idx = 0
        for row in range(2):
            for col in range(4):
                rect = (start_x + col * gap_x, start_y + row * gap_y, card_w, card_h)
                self.memory_cards.append(MemoryCard(rect, deck[idx]))
                idx += 1
        self.memory_first = None
        self.memory_second = None
        self.memory_flip_timer = 0
        self.memory_mismatch = False

    def _build_plate_game(self):
        self.plate_target = pygame.Rect(960, 250, 190, 190)
        self.plate_pieces = []
        base = [
            (930, 540),
            (1010, 570),
            (1110, 545),
            (1080, 625),
        ]
        target_positions = [
            (self.plate_target.x + 75, self.plate_target.y + 28),
            (self.plate_target.x + 125, self.plate_target.y + 74),
            (self.plate_target.x + 68, self.plate_target.y + 122),
            (self.plate_target.x + 135, self.plate_target.y + 140),
        ]
        colors = [WHITE, WHITE, WHITE, WHITE]
        for i in range(4):
            self.plate_pieces.append(DraggablePiece(f"piece{i}", base[i], target_positions[i], colors[i]))
        self.plate_done = False

    def _build_spice_game(self):
        spices = [
            ("Canela", (890, 230), RED),
            ("Orégano", (1015, 230), GREEN),
            ("Pimenta", (1140, 230), ORANGE),
        ]
        self.spice_jars = []
        self.spice_tags = []
        tag_texts = ["Canela", "Orégano", "Pimenta"]
        tag_positions = [(940, 430), (1060, 430), (1180, 430)]
        tag_colors = [RED, GREEN, ORANGE]
        for name, pos, color in spices:
            jar_rect = pygame.Rect(0, 0, 72, 96)
            jar_rect.center = pos
            self.spice_jars.append({"name": name, "rect": jar_rect, "color": color, "label": None})
        for text, pos, color in zip(tag_texts, tag_positions, tag_colors):
            self.spice_tags.append(LabelTag(text, pos, color))
        self.spice_done = False

    def _build_wire_game(self):
        self.wire_left = [
            WireEndpoint("A", (880, 640), RED),
            WireEndpoint("B", (980, 640), BLUE),
            WireEndpoint("C", (1080, 640), GREEN),
        ]
        self.wire_right = [
            WireEndpoint("A", (880, 560), RED),
            WireEndpoint("B", (980, 560), BLUE),
            WireEndpoint("C", (1080, 560), GREEN),
        ]
        self.wire_map = {"A": RED, "B": BLUE, "C": GREEN}
        self.completed_wires = set()

    def reset_scene_clicks(self):
        self.selected_item = None

    def run(self):
        while True:
            self.clock.tick(FPS)
            self.handle_events()
            self.update()
            self.draw()
            pygame.display.flip()

    def handle_events(self):
        for event in pygame.event.get():
            if event.type == pygame.QUIT:
                pygame.quit()
                sys.exit()

            if event.type == pygame.KEYDOWN and event.key == pygame.K_ESCAPE:
                if self.state != "scene":
                    self.state = "scene"
                    self.reset_scene_clicks()
                else:
                    pygame.quit()
                    sys.exit()

            if event.type == pygame.MOUSEBUTTONDOWN and event.button == 1:
                self.on_mouse_down(event.pos)
            if event.type == pygame.MOUSEBUTTONUP and event.button == 1:
                self.on_mouse_up(event.pos)
            if event.type == pygame.MOUSEMOTION:
                self.on_mouse_motion(event.pos, event.rel)

    def on_mouse_down(self, pos):
        if self.game_over:
            return

        if self.state == "scene":
            self.handle_scene_click(pos)
        elif self.state == "memory":
            self.handle_memory_click(pos)
        elif self.state == "plates":
            self.handle_plate_click(pos)
        elif self.state == "spices":
            self.handle_spice_click(pos)
        elif self.state == "wires":
            self.handle_wire_click(pos)

    def on_mouse_up(self, pos):
        if self.state == "plates" and self.dragging_piece:
            self.drop_plate_piece(pos)
        if self.state == "spices" and self.dragging_label:
            self.drop_spice_label(pos)

        self.dragging_piece = None
        self.dragging_label = None

    def on_mouse_motion(self, pos, rel):
        if self.state == "plates" and self.dragging_piece and not self.dragging_piece.snapped:
            self.dragging_piece.pos = [pos[0] + self.dragging_piece.offset[0], pos[1] + self.dragging_piece.offset[1]]
        if self.state == "spices" and self.dragging_label and not self.dragging_label.locked:
            self.dragging_label.pos = [pos[0] + self.dragging_label.offset[0], pos[1] + self.dragging_label.offset[1]]
            self.dragging_label.update_rect(self.font)
        if self.state == "scene" and self.selected_item == "rug" and self.rug_state["done"] is False:
            self.clean_rug_at(pos)

    def handle_scene_click(self, pos):
        if self.hotspots["oven"].collidepoint(pos) and not self.oven_state["done"]:
            self.state = "memory"
            return
        if self.hotspots["faucet"].collidepoint(pos) and not self.faucet_state["done"]:
            self.fix_faucet(pos)
            return
        if self.hotspots["book"].collidepoint(pos):
            self.show_book_page = not self.show_book_page
            self.message.show("Você abriu o livro de receitas.", 120)
            return
        if self.hotspots["spoon"].collidepoint(pos):
            if self.show_book_page:
                self.spoon_clicked = True
                self.message.show("A mesmo árvore que eu usei para fazer essa colher também usei para esses armários velhos", 240)
            return
        if self.hotspots["cabinet"].collidepoint(pos):
            self.cabinet_clicked = True
            self.message.show("Costumava deixar os pratos aqui, até certo dia...", 240)
            return
        if self.hotspots["plates"].collidepoint(pos) and self.cabinet_clicked and not self.plates_state["done"]:
            self.state = "plates"
            return
        if self.hotspots["rug"].collidepoint(pos):
            self.selected_item = "rug"
            return
        if self.hotspots["spices"].collidepoint(pos) and self.rug_state["done"] and not self.spice_state["done"]:
            self.state = "spices"
            return
        if self.hotspots["light"].collidepoint(pos) and self.spice_state["done"] and not self.light_state["done"]:
            self.state = "wires"
            return

    def handle_memory_click(self, pos):
        if self.memory_flip_timer > 0:
            return
        for card in self.memory_cards:
            if card.rect.collidepoint(pos) and not card.matched and not card.revealed:
                card.revealed = True
                if self.memory_first is None:
                    self.memory_first = card
                elif self.memory_second is None and card is not self.memory_first:
                    self.memory_second = card
                    if self.memory_first.creature == self.memory_second.creature:
                        self.memory_first.matched = True
                        self.memory_second.matched = True
                        self.memory_first = None
                        self.memory_second = None
                        if all(c.matched for c in self.memory_cards):
                            self.oven_state["done"] = True
                            self.state = "scene"
                            self.message.show("Quase que você teve que pegar água para apagar o fogo, ufa", 240)
                    else:
                        self.memory_flip_timer = 45
                        self.memory_mismatch = True
                break

    def handle_plate_click(self, pos):
        for piece in reversed(self.plate_pieces):
            if not piece.snapped and piece.rect().collidepoint(pos):
                self.dragging_piece = piece
                piece.dragging = True
                piece.offset = (piece.pos[0] - pos[0], piece.pos[1] - pos[1])
                break

    def drop_plate_piece(self, pos):
        piece = self.dragging_piece
        if piece and piece.target_rect.collidepoint(pos):
            piece.pos = [piece.target_rect.centerx, piece.target_rect.centery]
            piece.snapped = True
        else:
            piece.pos = piece.start_pos.copy()
        piece.dragging = False
        if all(p.snapped for p in self.plate_pieces):
            self.plates_state["done"] = True
            self.state = "scene"
            self.message.show("A tapete me ajudou a não quebrar tantos pratos assim.", 240)

    def handle_spice_click(self, pos):
        for tag in reversed(self.spice_tags):
            if not tag.locked and tag.rect.collidepoint(pos):
                self.dragging_label = tag
                tag.dragging = True
                tag.offset = (tag.pos[0] - pos[0], tag.pos[1] - pos[1])
                break

    def drop_spice_label(self, pos):
        tag = self.dragging_label
        dropped = False
        for jar in self.spice_jars:
            if jar["rect"].collidepoint(pos) and jar["name"] == tag.text:
                jar["label"] = tag.text
                tag.locked = True
                tag.pos = [jar["rect"].centerx, jar["rect"].bottom + 24]
                tag.update_rect(self.font)
                dropped = True
                break
        if not dropped and not tag.locked:
            tag.pos = tag.start_pos.copy()
            tag.update_rect(self.font)
        tag.dragging = False
        if all(jar["label"] == jar["name"] for jar in self.spice_jars):
            self.spice_done = True
            self.spice_state["done"] = True
            self.state = "scene"
            self.message.show("Se essa luz não estivesse tão ruim talvez eu conseguiria enxergar essa temperos direito...", 240)

    def handle_wire_click(self, pos):
        all_points = self.wire_left + self.wire_right
        for ep in all_points:
            if ep.hit(pos) and not ep.connected:
                if self.pending_wire is None:
                    self.pending_wire = ep
                else:
                    if self.pending_wire.name == ep.name and self.pending_wire.color == ep.color and self.pending_wire is not ep:
                        self.pending_wire.connected = True
                        ep.connected = True
                        self.completed_wires.add(ep.name)
                        self.wire_connections.append((self.pending_wire.pos, ep.pos, ep.color))
                        self.pending_wire = None
                        if len(self.completed_wires) == 3:
                            self.light_state["done"] = True
                            self.has_key = True
                            self.game_over = True
                    else:
                        self.pending_wire = ep
                break

    def fix_faucet(self, pos):
        for leak in self.leaks:
            if leak.collidepoint(pos):
                leak.inflate_ip(-12, -12)
                self.faucet_state["leaks_fixed"] += 1
                if self.faucet_state["leaks_fixed"] >= 3:
                    self.faucet_state["done"] = True
                    self.message.show("Às vezes ler um manual é melhor, como um livro de receitas...", 240)
                return
        self.message.show("Toque nas gotinhas do vazamento para consertar a torneira.", 120)

    def clean_rug_at(self, pos):
        hit_any = False
        for spot in self.rug_dust_spots:
            if spot.collidepoint(pos):
                spot.width = max(0, spot.width - 6)
                spot.height = max(0, spot.height - 6)
                hit_any = True
        remaining = [s for s in self.rug_dust_spots if s.width > 0 and s.height > 0]
        if hit_any and len(remaining) <= 2 and not self.rug_state["done"]:
            self.rug_state["done"] = True
            self.message.show("Essa poeira deve vir de quando usávamos todos esses temperos inúteis!", 240)

    def update(self):
        self.message.update()

        if self.state == "memory" and self.memory_flip_timer > 0:
            self.memory_flip_timer -= 1
            if self.memory_flip_timer == 0 and self.memory_mismatch:
                for card in self.memory_cards:
                    if not card.matched:
                        card.revealed = False
                self.memory_first = None
                self.memory_second = None
                self.memory_mismatch = False

    def draw(self):
        self.screen.fill(BG)
        self.draw_scene_background()

        if self.state == "scene":
            self.draw_scene_hotspots()
        elif self.state == "memory":
            self.draw_memory_game()
        elif self.state == "plates":
            self.draw_plate_game()
        elif self.state == "spices":
            self.draw_spice_game()
        elif self.state == "wires":
            self.draw_wire_game()

        self.draw_overlay_ui()

    def draw_scene_background(self):
        # usa a imagem enviada como base do cenário
        self.screen.blit(self.background_image, (0, 0))

        # hotspots invisíveis; deixe H para alternar a visualização no código se quiser depurar
        if getattr(self, "show_hotspots", False):
            overlay = pygame.Surface((WIDTH, HEIGHT), pygame.SRCALPHA)
            colors = {
                "oven": (255, 80, 80, 55),
                "faucet": (80, 140, 255, 55),
                "book": (255, 255, 180, 55),
                "spoon": (180, 120, 80, 55),
                "cabinet": (120, 80, 40, 55),
                "plates": (220, 220, 220, 55),
                "rug": (120, 60, 60, 55),
                "spices": (255, 180, 80, 55),
                "light": (255, 255, 120, 55),
            }
            for name, rect in self.hotspots.items():
                pygame.draw.rect(overlay, colors[name], rect, border_radius=8)
            self.screen.blit(overlay, (0, 0))

        # vazamentos da torneira
        for leak in self.leaks:
            if leak.width > 0 and leak.height > 0:
                pygame.draw.ellipse(self.screen, BLUE, leak)

        # livro aberto
        if self.show_book_page:
            self.draw_book_page()

        # chave final
        if self.has_key:
            self.draw_key_icon()

    def draw_scene_hotspots(self):
        # subtle hint labels when hovering could be added later; for now, just the scene.
        pass

    def draw_book_page(self):
        page = pygame.Rect(500, 160, 320, 340)
        pygame.draw.rect(self.screen, PAPER, page, border_radius=12)
        pygame.draw.rect(self.screen, (140, 120, 90), page, 3, border_radius=12)
        pygame.draw.line(self.screen, (180, 160, 130), (page.centerx, page.top + 10), (page.centerx, page.bottom - 10), 2)
        title = self.font_big.render("Receita de Bolo", True, BLACK)
        self.screen.blit(title, (page.x + 25, page.y + 24))
        for i, line in enumerate([
            "- 2 xícaras de farinha",
            "- 1 xícara de açúcar",
            "- 3 ovos",
            "- 1 colher de fermento",
            "- Misture até ficar homogêneo",
        ]):
            txt = self.font.render(line, True, BLACK)
            self.screen.blit(txt, (page.x + 25, page.y + 80 + i * 42))
        warning = self.font_big.render("!USAR A COLHER DE PAU PARA MEXER!", True, RED)
        self.screen.blit(warning, (page.x + 18, page.bottom - 72))

    def draw_key_icon(self):
        pygame.draw.rect(self.screen, YELLOW, (1120, 40, 50, 14), border_radius=6)
        pygame.draw.circle(self.screen, YELLOW, (1120, 47), 18, 4)
        pygame.draw.rect(self.screen, YELLOW, (1160, 36, 14, 22), border_radius=4)

    def draw_memory_game(self):
        overlay = pygame.Surface((WIDTH, HEIGHT), pygame.SRCALPHA)
        overlay.fill((0, 0, 0, 120))
        self.screen.blit(overlay, (0, 0))
        panel = pygame.Rect(80, 90, 1120, 530)
        pygame.draw.rect(self.screen, (235, 230, 220), panel, border_radius=20)
        pygame.draw.rect(self.screen, (70, 70, 70), panel, 3, border_radius=20)
        title = self.font_huge.render("Jogo da Memória: Criaturas Sobrenaturais", True, BLACK)
        self.screen.blit(title, (panel.x + 40, panel.y + 18))
        info = self.font.render("Encontre os pares para apagar o fogo.", True, BLACK)
        self.screen.blit(info, (panel.x + 42, panel.y + 78))

        for card in self.memory_cards:
            if card.matched:
                color = GREEN
                label = card.creature
            elif card.revealed:
                color = YELLOW
                label = card.creature
            else:
                color = METAL_DARK
                label = "?"
            pygame.draw.rect(self.screen, color, card.rect, border_radius=12)
            pygame.draw.rect(self.screen, BLACK, card.rect, 2, border_radius=12)
            txt = self.font.render(label, True, BLACK)
            self.screen.blit(txt, txt.get_rect(center=card.rect.center))

    def draw_plate_game(self):
        overlay = pygame.Surface((WIDTH, HEIGHT), pygame.SRCALPHA)
        overlay.fill((0, 0, 0, 120))
        self.screen.blit(overlay, (0, 0))
        panel = pygame.Rect(60, 80, 1160, 560)
        pygame.draw.rect(self.screen, (240, 235, 228), panel, border_radius=20)
        pygame.draw.rect(self.screen, (70, 70, 70), panel, 3, border_radius=20)
        title = self.font_huge.render("Junte as peças do prato quebrado", True, BLACK)
        self.screen.blit(title, (panel.x + 40, panel.y + 18))
        hint = self.font.render("Arraste cada peça para o contorno correto.", True, BLACK)
        self.screen.blit(hint, (panel.x + 40, panel.y + 76))

        pygame.draw.ellipse(self.screen, (255, 255, 255), self.plate_target)
        pygame.draw.ellipse(self.screen, (180, 180, 180), self.plate_target, 4)
        pygame.draw.circle(self.screen, (220, 220, 220), self.plate_target.center, 48, 2)
